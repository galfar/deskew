    (Len: 13; Code: $053), (Len: 13; Code: $054), (Len: 13; Code: $055), (Len: 13; Code: $05A),
    (Len: 13; Code: $05B), (Len: 13; Code: $064), (Len: 13; Code: $065), (Len: 11; Code: $008),
    (Len: 11; Code: $00C), (Len: 11; Code: $00D), (Len: 12; Code: $012), (Len: 12; Code: $013),
    (Len: 12; Code: $014), (Len: 12; Code: $015), (Len: 12; Code: $016), (Len: 12; Code: $017),
    (Len: 12; Code: $01C), (Len: 12; Code: $01D), (Len: 12; Code: $01E), (Len: 12; Code: $01F));

  FaxCodeCount = 104;
  FaxMaxMakeUp = 2560;

  { Bits needed to recognize any white / black / 2D mode code. }
  WhiteBits = 12;
  BlackBits = 13;
  ModeBits = 7;

type
  TFaxEntryKind = (fekInvalid, fekTerminating, fekMakeUp, fekEol);
  TFaxEntry = record
    Kind: TFaxEntryKind;
    Len: Byte;
    Run: SmallInt;
  end;

  TFaxMode = (fmPass, fmHorizontal, fmVertical, fmExtension, fmEol, fmInvalid);
  TFaxModeEntry = record
    Mode: TFaxMode;
    Len: Byte;
    Delta: ShortInt;   // for vertical mode: a1 - b1
  end;

var
  WhiteTable: array[0..(1 shl WhiteBits) - 1] of TFaxEntry;
  BlackTable: array[0..(1 shl BlackBits) - 1] of TFaxEntry;
  ModeTable: array[0..(1 shl ModeBits) - 1] of TFaxModeEntry;

function RunOfIndex(Index: Integer): Integer; inline;
begin
  if Index < 64 then
    Result := Index
  else
    Result := (Index - 63) * 64;
end;

procedure BuildRunTable(const Codes: array of TFaxCode; var Table: array of TFaxEntry; Bits: Integer);
var
  I, J, First, Count: Integer;
begin
  for I := 0 to High(Table) do
    Table[I].Kind := fekInvalid;
  for I := 0 to High(Codes) do
  begin
    // The code followed by any other bits leads to the same entry
    First := Codes[I].Code shl (Bits - Codes[I].Len);
    Count := 1 shl (Bits - Codes[I].Len);
    for J := First to First + Count - 1 do
    begin
      if I < 64 then
        Table[J].Kind := fekTerminating
      else
        Table[J].Kind := fekMakeUp;
      Table[J].Len := Codes[I].Len;
      Table[J].Run := RunOfIndex(I);
    end;
  end;
  // Eleven zero bits can only be the start of EOL (possibly preceded by more
  // fill zeros). The entry consumes just the eleven zeros; the rest of the
  // zeros and the final 1 are skipped when synchronizing, as in libtiff.
  for J := 0 to (1 shl (Bits - 11)) - 1 do
  begin
    Table[J].Kind := fekEol;
    Table[J].Len := 11;
    Table[J].Run := 0;
  end;
end;

procedure BuildModeTable;

  procedure Add(Code, Len: Integer; Mode: TFaxMode; Delta: Integer);
  var
    J: Integer;
  begin
    for J := Code shl (ModeBits - Len) to ((Code + 1) shl (ModeBits - Len)) - 1 do
    begin
      ModeTable[J].Mode := Mode;
      ModeTable[J].Len := Len;
      ModeTable[J].Delta := Delta;
    end;
  end;

var
  I: Integer;
begin
  for I := 0 to High(ModeTable) do
    ModeTable[I].Mode := fmInvalid;
  Add($1, 4, fmPass, 0);        // 0001
  Add($1, 3, fmHorizontal, 0);  // 001
  Add($1, 1, fmVertical, 0);    // 1        V0
  Add($3, 3, fmVertical, 1);    // 011      VR1: a1 is 1 pixel right of b1
  Add($2, 3, fmVertical, -1);   // 010      VL1
  Add($3, 6, fmVertical, 2);    // 000011   VR2
  Add($2, 6, fmVertical, -2);   // 000010   VL2
  Add($3, 7, fmVertical, 3);    // 0000011  VR3
  Add($2, 7, fmVertical, -3);   // 0000010  VL3
  Add($1, 7, fmExtension, 0);   // 0000001  followed by 3 bits of extension type
  Add($0, 7, fmEol, 0);         // 0000000  start of EOL
end;

{ Decoder }

type
  TRunResult = (rrOk, rrEol, rrBad, rrEof);
  TFaxPositions = array of Integer;

  TFaxDecoder = record
    Src: PByte;
    SrcBits: Int64;          // size of input in bits
    BytePos: NativeInt;      // next input byte
    Acc: Cardinal;           // bit accumulator, new bits enter at the bottom
    Avail: Integer;          // valid bits in Acc
    Width: Integer;
    { Positions of color changes of the reference row and of the row being
      decoded. Entry 2k is where the k-th black run starts, 2k + 1 where it
      ends. A finished row is terminated by three entries equal to Width. }
    Ref, Cur: TFaxPositions;
    CurCount: Integer;
    function Peek(N: Integer): Cardinal; inline;
    procedure Skip(N: Integer); inline;
    function BitsLeft: Int64; inline;
    procedure AlignTo(Bits: Integer);
    function ReadRun(Black: Boolean; out Run: Integer): TRunResult;
    function SyncEol(SawEol: Boolean): Boolean;
    function DecodeRow1D(out SawEol: Boolean): TRunResult;
    function DecodeRow2D(out SawEol: Boolean): TRunResult;
    procedure FinishRow;
    procedure FillRow(Dst: PByte);
  end;

{ Next N bits of input without consuming them. Beyond the end of input zeros
  are delivered; callers detect the end with BitsLeft. (libtiff pads with
  zeros the same way: "the original code depended on the input data being
  zero-padded to insure the decoder recognized an EOL before running out of
  data".) }
function TFaxDecoder.Peek(N: Integer): Cardinal;
begin
  while Avail < N do
  begin
    if BytePos * 8 < SrcBits then
      Acc := (Acc shl 8) or Src[BytePos]
    else
      Acc := Acc shl 8;
    Inc(BytePos);
    Inc(Avail, 8);
  end;
  Result := (Acc shr (Avail - N)) and ((Cardinal(1) shl N) - 1);
end;

procedure TFaxDecoder.Skip(N: Integer);
begin
  Dec(Avail, N);
end;

{ Number of real input bits not consumed yet; negative after reading into the
  zero padding. }
function TFaxDecoder.BitsLeft: Int64;
begin
  Result := SrcBits - (Int64(BytePos) * 8 - Avail);
end;

{ Skips to the next byte (8) or word (16) boundary of the input. }
procedure TFaxDecoder.AlignTo(Bits: Integer);
var
  Consumed: Int64;
  N: Integer;
begin
  Consumed := Int64(BytePos) * 8 - Avail;
  N := Consumed mod Bits;
  if N <> 0 then
  begin
    N := Bits - N;
    Peek(N);
    Skip(N);
  end;
end;

{ Reads one run length: any number of make-up codes and a terminating code. }
function TFaxDecoder.ReadRun(Black: Boolean; out Run: Integer): TRunResult;
var
  E: TFaxEntry;
begin
  Run := 0;
  while True do
  begin
    if Black then
      E := BlackTable[Peek(BlackBits)]
    else
      E := WhiteTable[Peek(WhiteBits)];
    case E.Kind of
      fekInvalid:
        begin
          // Either garbage or the end of input inside a code
          if BitsLeft <= 0 then
            Result := rrEof
          else
            Result := rrBad;
          Exit;
        end;
      fekEol:
        begin
          // Zeros of the padding after the end of input look like EOL too
          if BitsLeft < 11 then
          begin
            Result := rrEof;
            Exit;
          end;
          Skip(11);
          Result := rrEol;
          Exit;
        end;
    end;
    if BitsLeft < E.Len then
    begin
      Result := rrEof;
      Exit;
    end;
    Skip(E.Len);
    // Rows are at most Width long, anything more is clipped by the caller;
    // limiting here keeps endless make-up codes from overflowing Run
    if Run <= Width then
      Inc(Run, E.Run);
    if E.Kind = fekTerminating then
    begin
      Result := rrOk;
      Exit;
    end;
  end;
end;

{ Moves behind the EOL code that starts every row of Group 3 data. Returns
  False if there is none before the end of input.

  From libtiff's SYNC_EOL: unless the previous row already ran into the EOL
  (SawEol: its eleven zeros are consumed), input is searched bit by bit for
  eleven zero bits - this skips whatever is left of a damaged row. Then all
  zeros (fill bits, T4Options bit 2) up to and including the 1 that ends the
  EOL are skipped. }
function TFaxDecoder.SyncEol(SawEol: Boolean): Boolean;
begin
  Result := False;
  if not SawEol then
    while True do
    begin
      if BitsLeft < 12 then
        Exit;
      if Peek(11) = 0 then
        Break;
      Skip(1);
    end;
  while True do
  begin
    if BitsLeft <= 0 then
      Exit;
    if Peek(1) <> 0 then
      Break;
    Skip(1);
  end;
  Skip(1);
  Result := True;
end;

function TFaxDecoder.DecodeRow1D(out SawEol: Boolean): TRunResult;
var
  A0, Run: Integer;
  Black: Boolean;
begin
  SawEol := False;
  A0 := 0;
  Black := False;
  Result := rrOk;
  while A0 < Width do
  begin
    Result := ReadRun(Black, Run);
    if Result <> rrOk then
    begin
      // Row ends here. EOL in the middle of a row is libtiff's "Premature
      // EOL": the rest of the row stays white and the EOL is not searched
      // for again.
      SawEol := Result = rrEol;
      Break;
    end;
    Inc(A0, Run);
    if A0 > Width then
      A0 := Width;   // "Line length mismatch", the run is clipped
    // Guard against rows made of endless zero length runs
    if CurCount >= Length(Cur) - 6 then
    begin
      Result := rrBad;
      Break;
    end;
    Cur[CurCount] := A0;
    Inc(CurCount);
    Black := not Black;
  end;
  // A run still open when the row was cut is closed where it got to, the
  // remainder of the row is white (libtiff's CLEANUP_RUNS)
  if Odd(CurCount) and (A0 < Width) then
  begin
    Cur[CurCount] := A0;
    Inc(CurCount);
  end;
end;

function TFaxDecoder.DecodeRow2D(out SawEol: Boolean): TRunResult;
var
  A0, A1, B, B1, Run1, Run2, Color, Start: Integer;
  M: TFaxModeEntry;
begin
  SawEol := False;
  Result := rrOk;
  // A0 = -1: the imaginary pixel before the row, so that a change at
  // position 0 of the reference row can be b1
  A0 := -1;
  B := 0;
  Color := 0;   // 0 white, 1 black: also the parity of the next entry of Cur
  while A0 < Width do
  begin
    if CurCount >= Length(Cur) - 6 then
    begin
      Result := rrBad;   // libtiff: "Buffer overflow", row of endless empty runs
      Break;
    end;
    M := ModeTable[Peek(ModeBits)];
    if (M.Mode = fmInvalid) or (BitsLeft < M.Len) then
    begin
      if BitsLeft <= 0 then
        Result := rrEof
      else
        Result := rrBad;
      Break;
    end;
    Skip(M.Len);

    // b1: first change on the reference row right of a0 to the color opposite
    // of the current one, i.e. with the parity of Color. B only ever needs to
    // step back by one (after a "vertical left" code).
    while (B > 0) and (Ref[B - 1] > A0) do
      Dec(B);
    while (Ref[B] <= A0) and (Ref[B] < Width) do
      Inc(B);
    if (B and 1) <> Color then
      Inc(B);
    B1 := Ref[B];

    case M.Mode of
      fmPass:
        // Reference row has a run the coding row does not: jump over it
        // (b2), color stays
        A0 := Ref[B + 1];
      fmHorizontal:
        begin
          Result := ReadRun(Color = 1, Run1);
          if Result = rrOk then
            Result := ReadRun(Color = 0, Run2);
          if Result <> rrOk then
          begin
            SawEol := Result = rrEol;
            Break;
          end;
          if A0 < 0 then
            Start := 0
          else
            Start := A0;
          A1 := Start + Run1;
          if A1 > Width then
            A1 := Width;
          A0 := A1 + Run2;
          if A0 > Width then
            A0 := Width;
          Cur[CurCount] := A1;
          Cur[CurCount + 1] := A0;
          // Both runs can be empty: pointless but valid, and found in real
          // files (libtiff's testfax4.tiff). A row made of nothing else is
          // stopped by the check at the top of the loop.
          Inc(CurCount, 2);
        end;
      fmVertical:
        begin
          A1 := B1 + M.Delta;
          // libtiff: "if (b1 < a0 + param) unexpected(VL)"
          if (A1 < A0) or (A1 < 0) then
          begin
            Result := rrBad;
            Break;
          end;
          if A1 > Width then
            A1 := Width;
          Cur[CurCount] := A1;
          Inc(CurCount);
          A0 := A1;
          Color := Color xor 1;
        end;
      fmEol:
        begin
          // Seven zeros: EOL if four more follow. In Group 4 this is the
          // EOFB that ends the data, in Group 3 an EOL in the middle of a row.
          if (BitsLeft < 4) or (Peek(4) <> 0) then
            Result := rrBad
          else
          begin
            Skip(4);
            Result := rrEol;
            SawEol := True;
          end;
          Break;
        end;
    else
      // fmExtension: switch to uncompressed mode, which nobody implements.
      // libtiff reports "Uncompressed data (not supported)" and abandons
      // the row, we do the same.
      Result := rrBad;
      Break;
    end;
  end;
  if Odd(CurCount) and (A0 >= 0) and (A0 < Width) and (Result <> rrEol) then
  begin
    Cur[CurCount] := A0;
    Inc(CurCount);
  end;
end;

{ Terminates the row just decoded so it can serve as reference row. }
procedure TFaxDecoder.FinishRow;
begin
  Cur[CurCount] := Width;
  Cur[CurCount + 1] := Width;
  Cur[CurCount + 2] := Width;
end;

{ Sets bits of black runs of the current row. Dst is all zeros (white). }
procedure TFaxDecoder.FillRow(Dst: PByte);
var
  I, X0, X1, First, Last: Integer;
begin
  I := 0;
  while I < CurCount do
  begin
    X0 := Cur[I];
    // FinishRow made sure the entry after the last one is Width
    X1 := Cur[I + 1];
    Inc(I, 2);
    if X1 <= X0 then
      Continue;
    First := X0 shr 3;
    Last := (X1 - 1) shr 3;
    if First = Last then
      Dst[First] := Dst[First] or (($FF shr (X0 and 7)) and ($FF shl (7 - ((X1 - 1) and 7))) and $FF)
    else
    begin
      Dst[First] := Dst[First] or ($FF shr (X0 and 7));
      if Last > First + 1 then
        FillChar(Dst[First + 1], Last - First - 1, $FF);
      Dst[Last] := Dst[Last] or (($FF shl (7 - ((X1 - 1) and 7))) and $FF);
    end;
  end;
end;

{ TTiffFaxDecoder }

type
  PFaxDecoder = ^TFaxDecoder;

constructor TTiffFaxDecoder.Create(Compression: Integer; T4Options: Cardinal; Width: Integer);
var
  D: PFaxDecoder;
begin
  inherited Create;
  FCompression := Compression;
  FT4Options := T4Options;
  FWidth := Width;
  FRowBytes := (NativeInt(Width) + 7) div 8;
  New(D);
  FState := D;
  // Two entries per pixel is the worst a row can need (every pixel a run of
  // its own, coded with zero length partners), plus terminators
  if Width > 0 then
  begin
    SetLength(D.Ref, 2 * Width + 8);
    SetLength(D.Cur, 2 * Width + 8);
  end;
  D.Width := Width;
end;

destructor TTiffFaxDecoder.Destroy;
begin
  Dispose(PFaxDecoder(FState));
  inherited;
end;

{ Back to the start of the input with an imaginary white row as reference. }
procedure TTiffFaxDecoder.ResetInput;
var
  D: PFaxDecoder;
  I: Integer;
begin
  D := FState;
  D.Src := FSrc;
  D.SrcBits := Int64(FSrcSize) * 8;
  D.BytePos := 0;
  D.Acc := 0;
  D.Avail := 0;
  // Rows of a strip are coded relative to an imaginary white row above
  for I := 0 to 2 do
    D.Ref[I] := FWidth;
  FSawEol := False;
end;

procedure TTiffFaxDecoder.Start(Src: PByte; SrcSize: NativeInt);
begin
  inherited;
  FRow := 0;
  FHasEol := FCompression = TiffCompressionCcittFax3;
  FIs2D := (FCompression = TiffCompressionCcittFax4) or
    (FHasEol and ((FT4Options and TiffT4Options2D) <> 0));
  FRetried := False;
  FWhiteRest := False;
  FFinished := (FSrcSize <= 0) or (FWidth <= 0);
  if not FFinished then
    ResetInput;
end;

{ Decodes the next row into Dst (all zeros). False if there is none. }
function TTiffFaxDecoder.DecodeRow(Dst: PByte): Boolean;
var
  D: PFaxDecoder;
  RowIs1D: Boolean;
  Res: TRunResult;
  Temp: TFaxPositions;
begin
  Result := False;
  D := FState;
  RowIs1D := not FIs2D;
  if FHasEol then
  begin
    if not D.SyncEol(FSawEol) then
    begin
      // "Group 3 without EOL": some writers leave out the EOL codes
      // altogether although the specification requires them (libtiff
      // bug 54, test image testfax3_bug54_1dnoEOL.tif). If the strip has
      // no EOL at all it is decoded again as rows that just follow one
      // another, like libtiff does ("Try to decode (read) fax Group 3
      // data without EOL").
      if (FRow = 0) and not FSawEol and not FRetried then
      begin
        FRetried := True;
        FHasEol := False;
        FIs2D := False;
        ResetInput;
        Result := DecodeRow(Dst);
      end
      else
        FFinished := True;
      Exit;
    end;
    if FIs2D then
    begin
      // Tag bit after EOL: 1 = this row is 1D coded, 0 = 2D
      RowIs1D := D.Peek(1) = 1;
      D.Skip(1);
    end;
  end;

  D.CurCount := 0;
  if RowIs1D then
    Res := D.DecodeRow1D(FSawEol)
  else
    Res := D.DecodeRow2D(FSawEol);
  D.FinishRow;

  if FCompression = TiffCompressionCcittFax4 then
  begin
    // EOFB or end of input: no more rows. Like libtiff's Fax4Decode,
    // this counts as success if at least one row was decoded - Group 4
    // files that end a little early (or lack the EOFB) are common. The
    // rows not decoded stay white.
    if (Res = rrEol) or (Res = rrEof) then
    begin
      if Res = rrEof then
        D.FillRow(Dst);
      if FRow > 0 then
      begin
        FWhiteRest := True;
        Result := True;
      end
      else
        FFinished := True;
      Exit;
    end;
  end
  else if Res = rrEof then
  begin
    // "Premature EOF": what there is of the row is kept, but the strip
    // is short (libtiff fails the read here as well)
    D.FillRow(Dst);
    FFinished := True;
    Exit;
  end;

  D.FillRow(Dst);
  Temp := D.Ref;
  D.Ref := D.Cur;
  D.Cur := Temp;
  Inc(FRow);
  Result := True;

  // Rows of the RLE schemes start at byte or word boundaries
  case FCompression of
    TiffCompressionCcittRle: D.AlignTo(8);
    TiffCompressionCcittRleW: D.AlignTo(16);
  end;
end;

function TTiffFaxDecoder.Decode(Dst: PByte; Count: NativeInt): NativeInt;
var
  Rows, I: NativeInt;
begin
  Result := 0;
  if FRowBytes = 0 then
    Exit;
  Rows := Count div FRowBytes;
  FillChar(Dst^, Rows * FRowBytes, 0);
  for I := 0 to Rows - 1 do
  begin
    if not FWhiteRest then
      if FFinished or not DecodeRow(Dst + I * FRowBytes) then
        Exit;
    Inc(Result, FRowBytes);
  end;
end;

function TiffFaxDecode(Compression: Integer; T4Options: Cardinal;
  Src: PByte; SrcSize: NativeInt; Dst: PByte; Width, Rows: Integer): NativeInt;
begin
  Result := 0;
  if (Width <= 0) or (Rows <= 0) then
    Exit;
  Result := DecodeAll(TTiffFaxDecoder.Create(Compression, T4Options, Width), Src, SrcSize, Dst,
    ((NativeInt(Width) + 7) div 8) * Rows);
end;

{ Encoder }

type
  TFaxEncoder = record
    Output: ^TTiffOutBuffer;
    Acc: Cardinal;
    Count: Integer;        // bits waiting in Acc
    procedure PutBits(Code: Cardinal; Len: Integer);
    procedure PutRun(Run: Integer; Black: Boolean);
    procedure Flush;
  end;

procedure TFaxEncoder.PutBits(Code: Cardinal; Len: Integer);
begin
  Acc := (Acc shl Len) or Code;
  Inc(Count, Len);
  while Count >= 8 do
  begin
    Output^.AddByte((Acc shr (Count - 8)) and $FF);
    Dec(Count, 8);
  end;
end;

{ Run length as make-up codes and a terminating code (libtiff's putspan). }
procedure TFaxEncoder.PutRun(Run: Integer; Black: Boolean);
var
  Index: Integer;
begin
  // Longest make-up code is for 2560 pixels; longer runs repeat it
  while Run >= FaxMaxMakeUp + 64 do
  begin
    PutBits(FaxWhiteCodes[103].Code, FaxWhiteCodes[103].Len);   // same for black
    Dec(Run, FaxMaxMakeUp);
  end;
  if Run >= 64 then
  begin
    Index := 63 + (Run shr 6);
    if Black then
      PutBits(FaxBlackCodes[Index].Code, FaxBlackCodes[Index].Len)
    else
      PutBits(FaxWhiteCodes[Index].Code, FaxWhiteCodes[Index].Len);
    Run := Run and 63;
  end;
  if Black then
    PutBits(FaxBlackCodes[Run].Code, FaxBlackCodes[Run].Len)
  else
    PutBits(FaxWhiteCodes[Run].Code, FaxWhiteCodes[Run].Len);
end;

procedure TFaxEncoder.Flush;
begin
  if Count > 0 then
  begin
    Output^.AddByte((Acc shl (8 - Count)) and $FF);
    Count := 0;
  end;
end;

{ Finds positions of color changes in a row of packed bits (1 = black) and
  terminates the list with three entries of Width. Returns number of changes. }
function FindChanges(Row: PByte; Width: Integer; var Changes: array of Integer): Integer;
var
  X, N: Integer;
  Color, B: Byte;
begin
  N := 0;
  X := 0;
  Color := 0;
  while X < Width do
  begin
    // Whole bytes of the current color are skipped at once
    if (X and 7) = 0 then
    begin
      if Color = 0 then B := 0 else B := $FF;
      while (X + 8 <= Width) and (Row[X shr 3] = B) do
        Inc(X, 8);
      if X >= Width then
        Break;
    end;
    if ((Row[X shr 3] shr (7 - (X and 7))) and 1) <> Color then
    begin
      Changes[N] := X;
      Inc(N);
      Color := Color xor 1;
    end;
    Inc(X);
  end;
  Changes[N] := Width;
  Changes[N + 1] := Width;
  Changes[N + 2] := Width;
  Result := N;
end;

procedure TiffFax4Encode(Src: PByte; Width, Rows: Integer; var Output: TTiffOutBuffer);
const
  // Vertical mode codes for a1 - b1 = -3..3 (libtiff's vcodes, same as ModeTable)
  VCodes: array[-3..3] of TFaxCode = (
    (Len: 7; Code: $2), (Len: 6; Code: $2), (Len: 3; Code: $2), (Len: 1; Code: $1),
    (Len: 3; Code: $3), (Len: 6; Code: $3), (Len: 7; Code: $3));
var
  E: TFaxEncoder;
  Ref, Cur, Temp: array of Integer;
  RowBytes: NativeInt;
  Row, A, B, A0, A1, A2, B1, B2, Color, Start: Integer;
begin
  E.Output := @Output;
  E.Acc := 0;
  E.Count := 0;
  RowBytes := (NativeInt(Width) + 7) div 8;
  SetLength(Ref, Width + 4);
  SetLength(Cur, Width + 4);
  // First row is coded against an imaginary white row
  Ref[0] := Width;
  Ref[1] := Width;
  Ref[2] := Width;

  for Row := 0 to Rows - 1 do
  begin
    FindChanges(Src + Row * RowBytes, Width, Cur);
    A0 := -1;
    A := 0;
    B := 0;
    Color := 0;
    while A0 < Width do
    begin
      // a1: next change on this row; b1, b2 as in the decoder
      while (Cur[A] <= A0) and (Cur[A] < Width) do
        Inc(A);
      A1 := Cur[A];
      while (B > 0) and (Ref[B - 1] > A0) do
        Dec(B);
      while (Ref[B] <= A0) and (Ref[B] < Width) do
        Inc(B);
      if (B and 1) <> Color then
        Inc(B);
      B1 := Ref[B];
      B2 := Ref[B + 1];

      if B2 < A1 then
      begin
        E.PutBits($1, 4);           // pass: 0001
        A0 := B2;
      end
      else if Abs(A1 - B1) <= 3 then
      begin
        E.PutBits(VCodes[A1 - B1].Code, VCodes[A1 - B1].Len);
        A0 := A1;
        Color := Color xor 1;
      end
      else
      begin
        A2 := Cur[A + 1];
        if A0 < 0 then Start := 0 else Start := A0;
        E.PutBits($1, 3);           // horizontal: 001
        E.PutRun(A1 - Start, Color = 1);
        E.PutRun(A2 - A1, Color = 0);
        A0 := A2;
      end;
    end;
    Temp := Ref;
    Ref := Cur;
    Cur := Temp;
  end;

  // EOFB: two EOL codes. Each strip is terminated and padded to a whole byte.
  E.PutBits($1, 12);
  E.PutBits($1, 12);
  E.Flush;
end;

initialization
  BuildRunTable(FaxWhiteCodes, WhiteTable, WhiteBits);
  BuildRunTable(FaxBlackCodes, BlackTable, BlackBits);
  BuildModeTable;

end.
