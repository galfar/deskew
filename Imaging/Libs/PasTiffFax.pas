{ CCITT bilevel compression: ITU-T T.4 (Group 3 fax, one- and two-dimensional)
  and T.6 (Group 4 fax), as used by TIFF compression schemes 2, 3, 4 and 32771
  (TIFF 6.0 sections 10 and 11). Decoder for all of them, encoder for Group 4.

  How the coding works, in short. A row is a sequence of runs of white and
  black pixels, always starting with a white run (of zero length if the first
  pixel is black).
    - One-dimensional (Modified Huffman) coding stores the run lengths with
      fixed Huffman codes, different ones for white and black runs. Runs of
      64 pixels and more take one or more "make-up" codes for the multiple of
      64 followed by a "terminating" code for the rest.
    - Two-dimensional coding describes a row by how positions of its color
      changes differ from those in the row above (the reference row). With
      a0 = position coded so far, a1/a2 = next changes on the coding row,
      b1 = first change on the reference row right of a0 to the color
      opposite of the current one, b2 = the change after b1:
        Pass        b2 is left of a1: skip to b2, nothing changes color
        Vertical    a1 is within 3 pixels of b1: code the difference
        Horizontal  otherwise: code runs a0-a1 and a1-a2 one-dimensionally

  The TIFF schemes differ in framing:
    2      rows 1D coded, each starting at a byte boundary, no EOL codes
    32771  the same with rows starting at 16-bit word boundaries
    3      every row is preceded by EOL (000000000001); T4Options say whether
           rows may be 2D coded (then a tag bit after EOL tells for each row)
           and whether EOLs are padded to end at byte boundaries
    4      all rows 2D coded, no EOLs, first row refers to an imaginary white
           row, data ends with EOFB (two EOLs)

  Decoded rows are packed bits, most significant bit first, 1 = black, which
  is what TIFF stores for PhotometricInterpretation=MinIsWhite.

  Unlike libtiff this is not a table driven state machine generated by
  mkg3states: runs are looked up in tables indexed by the next 12 or 13 bits
  of input, built at startup from the code tables that the encoder needs
  anyway. What happens with damaged data (which is common for fax) is modelled
  on libtiff, see the comments in TFaxDecoder. }
unit PasTiffFax;

{$I PasTiff.inc}

interface

uses
  SysUtils, PasTiffTypes, PasTiffCodecs;

{ Decodes a strip or tile of Rows rows, Width pixels each, to Dst as rows of
  (Width + 7) div 8 bytes. Compression is one of the TiffCompressionCcitt*
  constants, T4Options the value of that tag (used by Group 3 only).
  Src must be in FillOrder=1 bit order (the reader reverses bits before).

  Returns number of bytes decoded; rows that could not be decoded are white.
  It is less than Rows * row size only when input ends before the last row
  of 1D coded data; all other damage is repaired row by row as libtiff does. }
function TiffFaxDecode(Compression: Integer; T4Options: Cardinal;
  Src: PByte; SrcSize: NativeInt; Dst: PByte; Width, Rows: Integer): NativeInt;

type
  { Resumable CCITT decoder: Decode delivers whole rows only, Count must be a
    multiple of the row size (Width + 7) div 8. Rows that could not be
    decoded are white (zero bytes). }
  TTiffFaxDecoder = class(TTiffChunkDecoder)
  private
    FCompression: Integer;
    FT4Options: Cardinal;
    FWidth: Integer;
    FRowBytes: NativeInt;
    FState: Pointer;        // TFaxDecoder, private to the implementation
    FRow: Integer;          // rows delivered so far
    FHasEol, FIs2D, FSawEol, FRetried: Boolean;
    FFinished: Boolean;     // no more rows can be decoded
    FWhiteRest: Boolean;    // Group 4 data ended early: the rest is white
    procedure ResetInput;
    function DecodeRow(Dst: PByte): Boolean;
  public
    constructor Create(Compression: Integer; T4Options: Cardinal; Width: Integer);
    destructor Destroy; override;
    procedure Start(Src: PByte; SrcSize: NativeInt); override;
    function Decode(Dst: PByte; Count: NativeInt): NativeInt; override;
  end;

{ Group 4 compresses Rows rows of packed bits (1 = black). }
procedure TiffFax4Encode(Src: PByte; Width, Rows: Integer; var Output: TTiffOutBuffer);

implementation

