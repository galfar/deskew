    object ComboResampling: TComboBox
      AnchorSideLeft.Control = LabResamling
      AnchorSideLeft.Side = asrBottom
      AnchorSideTop.Control = LabResamling
      AnchorSideTop.Side = asrCenter
      Left = 138
      Height = 23
      Hint = 'Filter used for rotating the image.'#13#10'Bilinear is fast and fine for most scans, Bicubic and Lanczos are sharper but slower.'#13#10'Nearest keeps the original pixel values (no new colors) but the edges get jagged.'
      Top = 39
      Width = 310
      BorderSpacing.Left = 20
      ItemHeight = 15
      ParentShowHint = False
      ShowHint = True
