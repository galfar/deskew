    object CheckForceRotation: TCheckBox
      AnchorSideTop.Control = CheckPrintParams
      AnchorSideTop.Side = asrCenter
      AnchorSideRight.Control = ComboOutputFormat
      AnchorSideRight.Side = asrBottom
      Left = 352
      Height = 19
