      AnchorSideLeft.Control = SpinEditDpiOverride
      AnchorSideTop.Control = CheckJpegQuality
      AnchorSideTop.Side = asrCenter
      AnchorSideRight.Control = SpinEditDpiOverride
      AnchorSideRight.Side = asrBottom
      Left = 100
      Height = 23
      Hint = 'JPEG quality from 1 to 100. Higher means better image and larger file.'
      Top = 132
      Width = 64
      Anchors = [akTop, akLeft, akRight]
      Enabled = False
      MinValue = 1
      ParentShowHint = False
      ShowHint = True
      TabOrder = 3
      Value = 90
    end
    object ComboTiffCompression: TComboBox
      AnchorSideTop.Control = CheckTiffCompression
      AnchorSideTop.Side = asrCenter
      AnchorSideRight.Control = ComboOutputFormat
      AnchorSideRight.Side = asrBottom
      Left = 312
      Height = 23
      Hint = 'Compression of TIFF output files.'#13#10'"As input" keeps the compression of the input TIFF, even lossy JPEG.'#13#10'"As input (lossless)" does the same but uses LZW instead of JPEG.'
      Top = 132
      Width = 136
      Anchors = [akTop, akRight]
      Enabled = False
      ItemHeight = 15
      ParentShowHint = False
      ShowHint = True
      Style = csDropDownList
      TabOrder = 5
    end
