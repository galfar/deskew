    object CheckDpiOverride: TCheckBox
      AnchorSideLeft.Control = CheckJpegQuality
      AnchorSideTop.Control = CheckJpegQuality
      AnchorSideTop.Side = asrBottom
      AnchorSideRight.Control = SpinEditDpiOverride
      Left = 10
      Height = 19
