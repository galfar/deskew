  object ActionList: TActionList
    Left = 216
    Top = 8
    object ActBrowseDeskewExe: TAction
      Caption = 'Browse...'
      Hint = 'Choose the Deskew command line tool executable.'
      OnExecute = ActBrowseDeskewExeExecute
    end
    object ActResetOptions: TAction
      Caption = 'Reset Options...'
      Hint = 'Set all the options back to their defaults, including the ones in the main window.'
