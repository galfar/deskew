      AnchorSideTop.Control = LabAngleStep
      AnchorSideTop.Side = asrCenter
      AnchorSideRight.Control = SpinEditDpiOverride
      Left = 294
      Height = 19
      Hint = 'Set the print resolution of the images yourself. It replaces the one stored in the input files.'#13#10'It is needed for margins in mm, cm or inches when the files have no resolution stored.'
      Top = 267
      Width = 82
      Anchors = [akTop, akRight]
      BorderSpacing.Right = 8
      Caption = 'DPI override'
      ParentShowHint = False
      ShowHint = True
