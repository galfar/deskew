    object EdExtraCmdArgs: TEdit
      AnchorSideLeft.Control = LabExtraCmdArgs
      AnchorSideLeft.Side = asrBottom
      AnchorSideTop.Control = Shape2
      AnchorSideTop.Side = asrBottom
      Left = 195
      Height = 23
      Hint = 'More parameters passed to the Deskew command line tool as they are.'#13#10#13#10'Examples: '#13#10'    Content rectangle:  -r 100,150,900,1200'#13#10'    JSON report file: -s r'#13#10'    Skew detection stats: -s s'#13#10'    All text infos: -s slpt'
      Top = 353
      Width = 219
      BorderSpacing.Left = 16
      BorderSpacing.Top = 20
      ParentShowHint = False
      ShowHint = True
      TabOrder = 12
    end
    object LabAngleStep: TLabel
      AnchorSideLeft.Control = LabForcedFormat
      AnchorSideTop.Control = CheckThresholdAuto
      AnchorSideTop.Side = asrBottom
      Left = 8
      Height = 15
      Hint = 'Step between the angles tried when looking for the skew. Smaller step is more precise but slower.'
      Top = 244
      Width = 75
      BorderSpacing.Top = 16
      Caption = 'Angle step [°]:'
      ParentColor = False
    end
