    object CheckJpegQuality: TCheckBox
      AnchorSideLeft.Control = LabOutputFileParams
      AnchorSideTop.Control = LabOutputFileParams
      AnchorSideTop.Side = asrBottom
      Left = 10
      Height = 19
      Hint = 'Set the compression quality of JPEG output files (and of TIFFs with JPEG compression). It is 90 by default.'
      Top = 134
      Width = 82
      BorderSpacing.Left = 2
      BorderSpacing.Top = 10
      Caption = 'JPEG quality'
      ParentShowHint = False
      ShowHint = True
      TabOrder = 2
    end
