    object SpinEditAngleStep: TFloatSpinEdit
      AnchorSideTop.Control = LabAngleStep
      AnchorSideTop.Side = asrCenter
      Left = 129
      Height = 23
      Hint = 'Step between the angles tried when looking for the skew. Smaller step is more precise but slower.'
      Top = 259
      Width = 64
      Increment = 0.05
      MaxValue = 5
      MinValue = 0.01
      ParentShowHint = False
      ShowHint = True
      TabOrder = 9
      Value = 0.1
