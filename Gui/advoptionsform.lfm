    object CheckJpegQuality: TCheckBox
      AnchorSideLeft.Control = LabOutputFileParams
      AnchorSideTop.Control = LabOutputFileParams
      AnchorSideTop.Side = asrBottom
      Left = 10
      Height = 19
      Hint = 'Set the compression quality of JPEG output files (and of TIFFs with JPEG compression). It is 90 by default.'
      Top = 109
      Width = 82
      BorderSpacing.Left = 2
      BorderSpacing.Top = 10
      Caption = 'JPEG quality'
      ParentShowHint = False
      ShowHint = True
      TabOrder = 2
    end
    object SpinEditJpegQuality: TSpinEdit
      AnchorSideLeft.Control = SpinEditDpiOverride
      AnchorSideTop.Control = CheckJpegQuality
      AnchorSideTop.Side = asrCenter
      AnchorSideRight.Control = SpinEditDpiOverride
      AnchorSideRight.Side = asrBottom
      Left = 100
      Height = 23
      Hint = 'JPEG quality from 1 to 100. Higher means better image and larger file.'
      Top = 107
      Width = 70
      Anchors = [akTop, akLeft, akRight]
      Enabled = False
      MinValue = 1
      ParentShowHint = False
      ShowHint = True
      TabOrder = 3
      Value = 90
    end
    object ComboTiffCompression: TComboBox
      AnchorSideTop.Control = CheckTiffCompression
      AnchorSideTop.Side = asrBottom
      AnchorSideRight.Control = ComboOutputFormat
      AnchorSideRight.Side = asrBottom
      Left = 292
      Height = 23
      Hint = 'Compression of TIFF output files.'#13#10'"As input" keeps the compression of the input TIFF, even lossy JPEG.'#13#10'"As input (lossless)" does the same but uses LZW instead of JPEG.'
      Top = 134
      Width = 150
      Anchors = [akTop, akRight]
      BorderSpacing.Top = 6
      Constraints.MinWidth = 150
      Enabled = False
      ItemHeight = 15
      ParentShowHint = False
      ShowHint = True
      Style = csDropDownList
      TabOrder = 5
    end
    object CheckTiffCompression: TCheckBox
      AnchorSideLeft.Control = ComboTiffCompression
      AnchorSideTop.Control = CheckJpegQuality
      AnchorSideTop.Side = asrCenter
      AnchorSideRight.Control = ComboTiffCompression
      AnchorSideRight.Side = asrBottom
      Left = 292
      Height = 19
      Hint = 'Choose the compression of TIFF output files. It is LZW by default (Group 4 Fax for 1bit images).'
      Top = 109
      Width = 110
      BorderSpacing.Top = 12
      Caption = 'TIFF compression'
      ParentShowHint = False
      ShowHint = True
      TabOrder = 4
    end
    object LabThresholding: TLabel
      AnchorSideLeft.Control = LabForcedFormat
      AnchorSideTop.Control = SpinThresholdValue
      AnchorSideTop.Side = asrCenter
      Left = 8
      Height = 15
      Hint = 'Pixels are split to text (dark) and background (light) by a threshold level before the skew is looked for:'#13#10'- Auto (default): the level is found for each image separately.'#13#10'- Level from 1 to 255: used for all the images, pixels darker than it are text.'#13#10'   A fixed level can help with faint print or dark paper.'
      Top = 211
      Width = 72
      BorderSpacing.Top = 20
      Caption = 'Thresholding:'
      ParentColor = False
    end
    object CheckThresholdAuto: TCheckBox
      AnchorSideLeft.Control = LabThresholding
      AnchorSideLeft.Side = asrBottom
      AnchorSideTop.Control = LabThresholding
      AnchorSideTop.Side = asrCenter
      Left = 92
      Height = 19
      Hint = 'Find the threshold between the text and the background automatically for each image.'#13#10'Uncheck to set the level yourself.'
      Top = 209
      Width = 44
      BorderSpacing.Left = 12
      Caption = 'Auto'
      ParentShowHint = False
      ShowHint = True
      TabOrder = 6
    end
    object SpinThresholdValue: TSpinEdit
      AnchorSideLeft.Control = CheckThresholdAuto
      AnchorSideLeft.Side = asrBottom
      AnchorSideTop.Control = Shape1
      AnchorSideTop.Side = asrBottom
      Left = 152
      Height = 23
      Hint = 'Threshold level from 1 to 255. Pixels darker than this are taken as text when looking for the skew.'
      Top = 207
      Width = 50
      BorderSpacing.Left = 16
      BorderSpacing.Top = 20
      MaxValue = 255
      MinValue = 1
      ParentShowHint = False
      ShowHint = True
      TabOrder = 7
      Value = 128
    end
