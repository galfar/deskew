    end
    object SpinEditMaxAngle: TFloatSpinEdit
      AnchorSideLeft.Control = LabMaxAngle
      AnchorSideLeft.Side = asrBottom
      AnchorSideTop.Control = LabMaxAngle
      AnchorSideTop.Side = asrCenter
      Left = 129
      Height = 23
      Hint = 'The largest skew angle that is looked for, in both directions. Larger value takes more time.'#13#10'Pages skewed more than this are left as they are.'
      Top = 234
      Width = 64
      BorderSpacing.Left = 8
      DecimalPlaces = 1
      MaxValue = 90
      MinValue = 1
      ParentShowHint = False
      ShowHint = True
      TabOrder = 8
      Value = 10
    end
