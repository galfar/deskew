      AnchorSideLeft.Control = LabOutputFileParams
      AnchorSideTop.Control = CheckJpegQuality
      AnchorSideTop.Side = asrCenter
      AnchorSideRight.Control = ComboTiffCompression
      Left = 198
      Height = 19
      Hint = 'Choose the compression of TIFF output files. It is LZW by default (Group 4 Fax for 1bit images).'
      Top = 134
      Width = 110
      Anchors = [akTop, akRight]
      BorderSpacing.Left = 20
      BorderSpacing.Top = 12
      BorderSpacing.Right = 4
      Caption = 'TIFF compression'
      ParentShowHint = False
      ShowHint = True
      TabOrder = 4
    end
