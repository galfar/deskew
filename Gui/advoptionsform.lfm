    object FlowPanel1: TFlowPanel
      AnchorSideLeft.Control = Panel1
      AnchorSideTop.Control = SpinEditAngleStep
      AnchorSideTop.Side = asrBottom
      AnchorSideRight.Control = Panel1
      AnchorSideRight.Side = asrBottom
      Left = 8
      Height = 38
      Top = 298
      Width = 432
      Anchors = [akTop, akLeft, akRight]
      AutoWrap = False
      BevelOuter = bvNone
      BorderSpacing.Left = 8
      BorderSpacing.Top = 16
      BorderSpacing.Right = 8
      ControlList = <      
        item
          Control = CheckPrintParams
          WrapAfter = waAuto
          Index = 0
        end      
        item
          Control = CheckDetectOnly
          WrapAfter = waAuto
          Index = 1
        end      
        item
          Control = CheckForceRotation
          WrapAfter = waAuto
          Index = 2
        end      
        item
          Control = CheckSaveWorkImage
          WrapAfter = waAuto
          Index = 3
        end>
      FlowLayout = tlTop
      FlowStyle = fsLeftRightTopBottom
      TabOrder = 18
      object CheckPrintParams: TCheckBox
        AnchorSideTop.Side = asrBottom
        Left = 0
        Height = 19
        Hint = 'Print the parameters passed to the Deskew command line tool into the output log.'
        Top = 0
        Width = 105
        Anchors = []
        AutoSize = False
        BorderSpacing.Right = 12
        Caption = 'Print parameters'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 0
      end
      object CheckDetectOnly: TCheckBox
        AnchorSideTop.Side = asrCenter
        Left = 117
        Height = 19
        Hint = 'Only detect the skew angle and print it into the output log. No output files are written.'
        Top = 0
        Width = 78
        Anchors = []
        AutoSize = False
        BorderSpacing.Right = 12
        Caption = 'Detect only'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 1
      end
      object CheckForceRotation: TCheckBox
        Left = 207
        Height = 19
        Hint = 'Rotate the image always: also when the detected skew angle is not reliable (blank pages, pages without text lines)'#13#10'or smaller than the skip angle. Such pages are left as they are by default.'
        Top = 0
        Width = 92
        Anchors = []
        AutoSize = False
        BorderSpacing.Right = 12
        Caption = 'Force rotation'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 2
      end
