    object ComboOutputFormat: TComboBox
      AnchorSideLeft.Control = ComboResampling
      AnchorSideTop.Control = LabForcedFormat
      AnchorSideTop.Side = asrCenter
      Left = 138
      Height = 23
      Hint = 'Pixel format of the output image.'#13#10'By default it follows the input, only 1bit images become 8bit grayscale so the rotated text stays smooth.'
