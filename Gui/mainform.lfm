  object ActionList: TActionList
    Left = 280
    Top = 200
    object ActDeskew: TAction
      Caption = 'Deskew!'
      Hint = 'Deskew all the files in the list.'
      OnExecute = ActDeskewExecute
      OnUpdate = ActDeskewUpdate
    end
    object ActFinish: TAction
      Caption = 'Stop'
      Hint = 'Stop the processing or go back to the list of input files when it is done.'
      OnExecute = ActFinishExecute
    end
    object ActAddFiles: TAction
      Caption = 'Add files...'
      Hint = 'Choose image files and add them to the list.'
      OnExecute = ActAddFilesExecute
    end
    object ActClearFiles: TAction
      Caption = 'Clear'
      Hint = 'Remove all the files from the list.'
      OnExecute = ActClearFilesExecute
    end
    object ActBrowseOutputDir: TAction
      Caption = 'Browse...'
      Hint = 'Choose the output folder.'
      OnExecute = ActBrowseOutputDirExecute
